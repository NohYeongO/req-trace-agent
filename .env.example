# req-trace-agent 환경 설정 — 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 커밋하지 않음)

# ── 사업 정보 ───────────────────────────────────────────────────────────
PROJECT_NAME="제로파이브 스토어 구축 사업(데모)"   # 공백이 있으면 따옴표 필수(실행 스크립트가 bash로 source함)
# 데모 데이터는 2026-02~03 기준이다. '이번 주'·위험 신호 같은 날짜 해석을 데모 시점에 맞추려면 지정한다.
FIXED_TODAY=2026-03-10

# ── 저장소 ─────────────────────────────────────────────────────────────
# 업무 DB(요구사항·완료 조건·완료 보고)는 실행 스크립트가 지우지 않는다.
# 세션 DB(채팅 이력)는 에이전트를 기동할 때마다 비운다.
# DB_PATH=data/req_trace.db
# SESSION_DB_PATH=session.db
# OUTPUT_DIR=output

# ── LLM ─────────────────────────────────────────────────────────────────
# LLM_BACKEND는 실행 스크립트가 정한다(run_agent_ollma.sh=ollama, run_agent_openai.sh=openai).
# 직접 server.py를 띄울 때만 지정: fake | ollama | openai
# LLM_BACKEND=fake
# OLLAMA_FAST_MODEL=qwen3:0.6b
# OLLAMA_QUALITY_MODEL=qwen3:8b
# LLM_BACKEND=openai에서만 필요 — 실제 과금되는 키. 절대 커밋하지 말 것.
OPENAI_API_KEY=sk-...
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# ── 완료 보고 근거 확인 대상 ────────────────────────────────────────────
# (권장) 팀 공용 Git 저장소. 확인할 때마다 납품 브랜치를 fetch해 '푸시된 코드'만 근거로 인정한다.
# 커밋은 저장소에서, PR 번호는 GitHub API로 확인한다(공개 저장소는 토큰 없이, 비공개는 GITHUB_TOKEN).
# 데모: 커머스 프로젝트 zerofive-store. 본인 프로젝트는 팀 저장소 주소로 바꾼다.
ARTIFACT_REPO_URL=https://github.com/NohYeongO/zerofive-store.git
ARTIFACT_BRANCH=main
# GITHUB_TOKEN=
# (대안) 서버가 있는 컴퓨터의 로컬 폴더. ARTIFACT_REPO_URL이 있으면 무시된다.
# ARTIFACT_ROOT=/path/to/your/project
# 요구사항 검색 임베더: ollama(bge-m3, 기본) | hash(네트워크 없음, 정확도 낮음)
# EMBEDDER=ollama
# OLLAMA_EMBED_MODEL=bge-m3

# ── LangSmith 추적 (선택) ───────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=req-trace-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
